---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import MaintenanceScenarios from '../components/MaintenanceScenarios.astro'
import HelpChain from '../components/HelpChain.astro'
import ProductLines from '../components/ProductLines.astro'
import SupportPanel from '../components/SupportPanel.astro'
import ApplicationsGallery from '../components/ApplicationsGallery.astro'
import MroChain from '../components/MroChain.astro'
import SegmentsShowcase from '../components/SegmentsShowcase.astro'
import WhyBrand from '../components/WhyBrand.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
  <Header />

  <main id="main">
    <Hero />
    {/* Necessidade */}
    <MaintenanceScenarios />
    {/* Mapa da cadeia; as seções seguintes entregam cada etapa, uma ideia por seção */}
    <HelpChain />
    {/* 01 Identificar */}
    <SupportPanel />
    {/* 02 Encontrar — único bloco de portfólio */}
    <ProductLines />
    {/* 03 Orientar — quem atende, por equipamento e por setor */}
    <WhyBrand />
    <ApplicationsGallery />
    <SegmentsShowcase />
    {/* 04 Resolver — consolidação da aplicação */}
    <MroChain />
    <QuoteForm />
  </main>

  <Footer />
</Layout>
