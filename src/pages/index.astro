---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import ProductLines from '../components/ProductLines.astro'
import SupportPanel from '../components/SupportPanel.astro'
import ApplicationsGallery from '../components/ApplicationsGallery.astro'
import MroChain from '../components/MroChain.astro'
import SegmentsShowcase from '../components/SegmentsShowcase.astro'
import WhyBrand from '../components/WhyBrand.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Footer from '../components/Footer.astro'
---

<Layout>
  <Header />

  <main id="main">
    <Hero />
    <ProductLines />
    <SupportPanel />
    <ApplicationsGallery />
    <MroChain />
    <SegmentsShowcase />
    <WhyBrand />
    <QuoteForm />
  </main>

  <Footer />
</Layout>
