---
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { site } from '../data/site'

/* Território "máquina parada / urgência": cada card é uma situação que chega na
   manutenção e uma linha só com o que a Pioneira faz nela. O card inteiro é o
   CTA. Fala-se de capacidade (identificar, encontrar, orientar, resolver),
   nunca de prazo de entrega ou de estoque. */
const scenarios = [
  {
    icon: 'power',
    title: 'Máquina parada',
    outcome: 'Identificação por foto ou medida, sem referência.',
  },
  {
    icon: 'refresh',
    title: 'Reposição',
    outcome: 'Equivalente para item fora de linha ou recodificado.',
  },
  {
    icon: 'help-circle',
    title: 'Peça sem código',
    outcome: 'Peça desgastada ou sem gravação? A equipe identifica.',
  },
  {
    icon: 'search-x',
    title: 'Não encontrado',
    outcome: 'Busca por equivalência técnica na aplicação inteira.',
  },
  {
    icon: 'timer',
    title: 'Parada programada',
    outcome: 'Aplicação inteira cotada em um só atendimento.',
  },
] as const
---

<section id="situacoes" class="bg-neutral-light pt-16 pb-14 lg:pt-20 lg:pb-16">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    {/* Cabeçalho à esquerda, CTA à direita */}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="max-w-2xl">
        <Eyebrow>Quando a manutenção precisa</Eyebrow>

        <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
          Máquina parada, reposição urgente <br class="hidden sm:block" />
          ou componente sem referência?
        </h2>

        <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-base">
          Envie o que tiver em mãos. A {site.brandShort} identifica, encontra, orienta e resolve.
        </p>
      </div>

      <Button variant="navy" class="w-full sm:w-auto lg:shrink-0">
        Falar com especialista
      </Button>
    </div>

    {/* Situações — o card inteiro é o CTA */}
    <ul
      class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-5"
      aria-label="Situações de manutenção atendidas"
    >
      {scenarios.map((scenario) => (
        <li>
          <button
            type="button"
            class="btn-slave-whats scenario-card group relative flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-5 text-left shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]"
          >
            {/* Barra de acento no topo — cresce no hover */}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
            />

            <span class="flex size-11 items-center justify-center rounded-xl bg-neutral-gray-100 text-primary-dark-800 transition-colors duration-300 group-hover:bg-accent-orange/10 group-hover:text-accent-orange">
              <Icon name={scenario.icon} class="size-5" />
            </span>

            <span class="mt-4 font-display text-[17px] leading-snug font-extrabold text-ink">
              {scenario.title}
            </span>

            <span class="mt-1.5 font-sans text-[13px] leading-relaxed text-ink-soft">
              {scenario.outcome}
            </span>

            <span class="mt-auto flex items-center gap-2 pt-4 font-sans text-[13px] font-bold text-primary-dark transition-colors duration-200 group-hover:text-accent-orange">
              Falar com especialista
              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-neutral-gray-100 text-primary-dark transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light">
                <Icon name="arrow-right" class="size-3.5" />
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .scenario-card,
    .scenario-card * {
      transition: none !important;
    }

    .scenario-card:hover {
      transform: none;
    }
  }
</style>
