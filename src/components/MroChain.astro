---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import productComposition from '../assets/mro-product-composition.png'

/* Etapa 04: o ganho de consolidar a aplicação, falado para Manutenção e Compras.
   A lista de produtos já está nas linhas de produto e na imagem ao lado; aqui
   entram só os efeitos da consolidação, sem promessa de prazo ou estoque. */
const gains = [
  { icon: 'file-text', label: 'Uma cotação', hint: 'para todos os itens da aplicação' },
  { icon: 'layers', label: 'Itens compatíveis', hint: 'conferidos no conjunto, não peça a peça' },
  { icon: 'users', label: 'Um só interlocutor', hint: 'da dúvida técnica ao pedido' },
  { icon: 'box', label: 'Menos fornecedores', hint: 'para Compras cadastrar e acompanhar' },
  { icon: 'search', label: 'Menos tempo de procura', hint: 'sem cotar item por item no mercado' },
] as const
---

<section id="escopo" class="navy-premium relative overflow-hidden pt-12 pb-16 lg:pt-16 lg:pb-20">
  <span aria-hidden="true" class="bg-blueprint pointer-events-none absolute inset-0"></span>

  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-28 -left-24 size-80 rounded-full bg-accent-orange/12 blur-3xl"
  ></span>

  <div class="relative mx-auto max-w-page px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,460px)] lg:items-stretch lg:gap-16">
      {/* Texto — a imagem ocupa a sobra para as duas colunas fecharem na mesma altura */}
      <div class="flex max-w-xl flex-col">
        {/* Composição de produtos: 16/9 no mobile, faixa 3/1 no desktop */}
        <div class="mro-product-composition relative mb-7 flex aspect-[16/9] w-full items-center lg:aspect-[3/1] lg:min-h-[10.5rem] lg:flex-none">
          <Image
            src={productComposition}
            alt="Composição de acoplamentos, correias, mancais, vedações e componentes de montagem"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>

        <Eyebrow tone="light">Etapa 04 · Resolver</Eyebrow>

        <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-neutral-light sm:text-4xl">
          Resolva a aplicação inteira <br class="hidden sm:block" />
          em um pedido
        </h2>

        <span aria-hidden="true" class="mt-5 block h-[3px] w-16 bg-accent-orange"></span>

        <p class="mt-5 font-sans text-[15px] leading-relaxed text-neutral-light/75 sm:text-base">
          Do rolamento ao acessório de montagem, os componentes da mesma{' '}
          <br class="hidden sm:block" />
          aplicação saem juntos, especificados e cotados de uma vez. Menos{' '}
          <br class="hidden sm:block" />
          fornecedores para Compras, menos procura para a Manutenção.
        </p>

        <Button
          variant="primary"
          class="mt-7 w-full shadow-[0_14px_30px_-12px_rgba(255,107,0,0.85)] sm:w-auto"
        >
          Solicite sua cotação
        </Button>
      </div>

      {/* Ganhos da consolidação — os itens dividem a altura da coluna de texto */}
      <ul class="flex flex-col gap-3 lg:h-full" aria-label="O que muda ao consolidar a aplicação">
        {gains.map((gain) => (
          <li class="chain-node relative flex items-center gap-4 rounded-xl border border-white/12 bg-white/[0.04] px-4 py-3.5 transition-[background-color,border-color] duration-[260ms] lg:flex-1">
            <span class="chain-badge relative flex size-11 shrink-0 items-center justify-center rounded-full text-neutral-light">
              <Icon name={gain.icon} class="size-[18px]" />
            </span>

            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="font-sans text-[14px] leading-none font-bold tracking-[0.02em] text-neutral-light uppercase">
                {gain.label}
              </span>
              <span class="font-sans text-[12.5px] leading-snug text-neutral-light/60">
                {gain.hint}
              </span>
            </span>

            <Icon name="check" class="size-4 shrink-0 text-accent-orange" />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .mro-product-composition::after {
    content: '';
    position: absolute;
    right: 8%;
    bottom: 2%;
    left: 8%;
    z-index: -1;
    height: 16%;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.35);
    filter: blur(22px);
  }

  .chain-node:hover {
    background-color: rgb(255 255 255 / 0.07);
    border-color: rgb(255 107 0 / 0.35);
  }

  .chain-badge {
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.16) 0%,
      rgb(255 255 255 / 0.04) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.16);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -10px 14px -10px rgb(255 107 0 / 0.45),
      0 12px 22px -14px rgb(0 0 0 / 0.85);
    transition:
      border-color 260ms ease,
      background-image 260ms ease;
  }

  .chain-node:hover .chain-badge {
    border-color: rgb(255 107 0 / 0.6);
    background-image: linear-gradient(160deg, rgb(255 107 0 / 0.3) 0%, rgb(255 107 0 / 0.08) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .chain-node,
    .chain-badge {
      transition: none;
    }
  }
</style>
