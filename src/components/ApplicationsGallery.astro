---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Icon from './Icon.astro'
import Eyebrow from './Eyebrow.astro'
import motoresPhoto from '../assets/applications/motores.png'
import bombasPhoto from '../assets/applications/bombas.png'
import redutoresPhoto from '../assets/applications/redutores.png'
import transportadoresPhoto from '../assets/applications/transportadores.png'
import maquinasPhoto from '../assets/applications/maquinas.png'

/* O card descreve o sintoma no equipamento, não a lista de componentes: o
   portfólio aparece uma vez só, na seção de linhas de produto. */
interface Application {
  index: string
  label: string
  description: string
  photo: ImageMetadata
  alt: string
}

const applications: readonly Application[] = [
  {
    index: '01',
    label: 'Motores elétricos',
    description: 'Ruído, vibração ou aquecimento no mancal do conjunto motorizado.',
    photo: motoresPhoto,
    alt: 'Motor elétrico industrial',
  },
  {
    index: '02',
    label: 'Bombas',
    description: 'Vazamento na vedação ou desgaste no acoplamento de acionamento.',
    photo: bombasPhoto,
    alt: 'Bomba centrífuga industrial',
  },
  {
    index: '03',
    label: 'Redutores',
    description: 'Retentor vazando ou folga nos rolamentos do eixo.',
    photo: redutoresPhoto,
    alt: 'Redutor de velocidade industrial',
  },
  {
    index: '04',
    label: 'Transportadores',
    description: 'Mancais e rolos travando em operação contínua.',
    photo: transportadoresPhoto,
    alt: 'Esteira transportadora de rolos',
  },
  {
    index: '05',
    label: 'Máquinas e equipamentos',
    description: 'Componente sem referência em máquina antiga ou importada.',
    photo: maquinasPhoto,
    alt: 'Linha de máquinas industriais com conjuntos de rolos e volantes de ajuste',
  },
]
---

<section id="aplicacoes" class="bg-neutral-light pt-16 pb-20">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    {/* Cabeçalho centralizado */}
    <div class="mx-auto max-w-4xl text-center">
      <Eyebrow>Orientação por equipamento</Eyebrow>
      <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
        Os equipamentos que giram na sua planta
      </h2>
      <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft">
        Do sintoma que a manutenção enxerga ao componente que precisa ser trocado.
      </p>
    </div>

    {/* Galeria de aplicações — o card inteiro é o CTA */}
    <ul class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-5" aria-label="Aplicações atendidas">
      {applications.map((app) => (
        <li>
          <button
            type="button"
            class="btn-slave-whats app-card group relative flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light text-left shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]"
          >
            {/* Barra de acento no topo — cresce no hover */}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
            />

            {/* Foto */}
            <span class="relative block aspect-[4/3] w-full overflow-hidden bg-neutral-gray-100">
              <Image
                src={app.photo}
                alt={app.alt}
                format="webp"
                width={640}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.06]"
              />

              {/* Véu suave na base para o índice ficar legível */}
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-primary-dark-900/55 to-transparent"
              />

              <span class="absolute bottom-3 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-neutral-light/85">
                {app.index}
              </span>
            </span>

            {/* Rótulo */}
            <span class="flex flex-1 items-start justify-between gap-2 px-4 pt-4 pb-5">
              <span class="flex min-w-0 flex-col gap-1.5">
                <span class="font-display text-[17px] leading-snug font-extrabold text-ink">
                  {app.label}
                </span>
                <span class="min-h-[4.9em] font-sans text-[13px] leading-relaxed text-ink-soft">
                  {app.description}
                </span>
              </span>

              <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-gray-100 text-primary-dark transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light">
                <Icon name="arrow-right" class="size-3.5" />
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
