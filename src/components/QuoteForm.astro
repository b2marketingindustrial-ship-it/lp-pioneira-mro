---
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { shortcodes } from '../data/site'

const trust = [
  { icon: 'clock', label: 'Retorno comercial rápido' },
  { icon: 'search', label: 'Apoio na identificação' },
  { icon: 'map-pin', label: 'Campinas e região' },
] as const
---

<section id="cotacao" class="bg-neutral-gray-100 pt-8 pb-20">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      {/* Shortcode do formulário; placeholder quando não houver valor */}
      <div class="order-2 w-full lg:order-1">
        <slot name="shortcode">
          {shortcodes.form ? (
            <div class="min-h-[520px] w-full" set:html={shortcodes.form} />
          ) : (
            <div class="flex min-h-[520px] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-primary-dark/25 bg-neutral-light p-8 text-center shadow-[0_14px_32px_-26px_rgba(0,24,48,0.5)]">
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Espaço reservado
              </span>
              <p class="font-display text-lg font-bold text-ink">
                Shortcode — formulário de cotação
              </p>
              <p class="max-w-xs font-sans text-sm leading-relaxed text-ink-soft">
                O plugin de atendimento do WordPress injeta o formulário neste espaço.
              </p>
            </div>
          )}
        </slot>
      </div>

      {/* Texto de contato */}
      <div class="order-1 lg:order-2">
        <Eyebrow>Cotação</Eyebrow>

        <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
          Receba sua cotação
          <br class="hidden sm:block" />
          com apoio técnico
        </h2>

        <span aria-hidden="true" class="mt-5 block h-[3px] w-16 bg-accent-orange"></span>

        <p class="mt-5 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-base">
          Descreva o item do jeito que for possível: nossa equipe volta com a especificação e o
          preço.
        </p>

        <Button
          variant="navy"
          iconName="whatsapp"
          iconPosition="left"
          class="mt-6 w-full sm:w-auto"
        >
          Chamar no WhatsApp
        </Button>

        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5" aria-label="Compromissos de atendimento">
          {trust.map((item) => (
            <li class="flex items-center gap-2 font-sans text-[13px] font-medium text-ink">
              <Icon name={item.icon} class="size-4 shrink-0 text-accent-orange" />
              {item.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
