---
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'

const items = [
  { icon: 'barcode', label: 'Referência', hint: 'ou código gravado' },
  { icon: 'tag', label: 'Fabricante', hint: 'marca do componente' },
  { icon: 'camera', label: 'Foto', hint: 'do componente' },
  { icon: 'ruler', label: 'Medidas', hint: 'principais dimensões' },
  { icon: 'factory', label: 'Equipamento', hint: 'onde é aplicado' },
  { icon: 'target', label: 'Aplicação', hint: 'como trabalha' },
] as const
---

<section id="identificar" class="bg-neutral-light pt-6 pb-16">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="support-panel navy-premium relative overflow-hidden rounded-2xl border border-white/12 p-6 shadow-[0_14px_32px_-26px_rgba(0,24,48,0.5)] sm:p-8 lg:px-10 lg:py-9">
      {/* Textura técnica: malha de blueprint esmaecida nas bordas */}
      <span aria-hidden="true" class="bg-blueprint pointer-events-none absolute inset-0"></span>

      {/* Brilho laranja no canto superior direito */}
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-accent-orange/15 blur-3xl"
      ></span>

      <div class="relative">
        {/* Linha superior — título à esquerda, CTA à direita */}
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
          <div class="max-w-2xl">
            <Eyebrow tone="light">Apoio na identificação</Eyebrow>

            <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-neutral-light sm:text-4xl">
              Não sabe qual componente precisa?
            </h2>

            <p class="mt-3 font-sans text-[15px] leading-relaxed text-neutral-light/70">
              Envie os dados disponíveis da máquina ou do componente
              <br class="hidden sm:block" />e nossa equipe direciona a identificação.
            </p>
          </div>

          <div class="flex flex-col items-stretch gap-4 lg:shrink-0 lg:items-end">
            <Button
              variant="primary"
              iconName="search"
              iconPosition="left"
              class="w-full shadow-[0_14px_30px_-12px_rgba(255,107,0,0.85)] lg:w-auto"
            >
              Identifique seu componente
            </Button>

            <span class="flex items-center justify-center gap-2 font-sans text-xs text-neutral-light/60 lg:justify-end">
              <Icon name="shield" class="size-4 shrink-0 text-accent-orange" />
              Retorno com atendimento comercial
            </span>
          </div>
        </div>

        {/* Faixa inferior — dados úteis para a identificação */}
        <ul
          class="support-strip mt-7 grid grid-cols-2 gap-y-5 rounded-xl border border-white/12 bg-white/[0.04] py-4 sm:grid-cols-3 lg:grid-cols-6"
          aria-label="Dados que ajudam na identificação"
        >
          {items.map((item) => (
            <li class="support-item flex flex-col items-start gap-2 px-2.5 sm:flex-row sm:items-center sm:gap-3 sm:px-3.5">
              <span class="support-badge relative flex size-10 shrink-0 items-center justify-center rounded-full text-neutral-light">
                <Icon name={item.icon} class="size-[17px]" />
              </span>

              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-sans text-[13px] leading-none font-bold text-neutral-light">
                  {item.label}
                </span>
                <span class="font-sans text-[11px] leading-snug text-neutral-light/55">
                  {item.hint}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Divisórias entre os itens da faixa, respeitando cada quebra de grid */
  .support-item + .support-item {
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }

  .support-strip > .support-item:nth-child(2n + 1) {
    border-left: 0;
  }

  @media (width >= 40rem) {
    .support-strip > .support-item:nth-child(2n + 1) {
      border-left: 1px solid rgb(255 255 255 / 0.12);
    }

    .support-strip > .support-item:nth-child(3n + 1) {
      border-left: 0;
    }
  }

  @media (width >= 64rem) {
    .support-strip > .support-item:nth-child(3n + 1) {
      border-left: 1px solid rgb(255 255 255 / 0.12);
    }

    .support-strip > .support-item:first-child {
      border-left: 0;
    }
  }

  /* Badge de vidro com brilho interno */
  .support-badge {
    background-image: linear-gradient(
      160deg,
      rgb(255 255 255 / 0.16) 0%,
      rgb(255 255 255 / 0.04) 100%
    );
    border: 1px solid rgb(255 255 255 / 0.16);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      inset 0 -10px 14px -10px rgb(255 107 0 / 0.45),
      0 12px 22px -14px rgb(0 0 0 / 0.85);
    transition:
      transform 260ms ease,
      border-color 260ms ease,
      background-image 260ms ease,
      box-shadow 260ms ease;
  }

  /* Anel laranja que surge no hover */
  .support-badge::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 9999px;
    border: 1px solid rgb(255 107 0 / 0.55);
    opacity: 0;
    transform: scale(0.88);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
    pointer-events: none;
  }

  .support-item:hover .support-badge {
    transform: translateY(-2px);
    border-color: rgb(255 107 0 / 0.6);
    background-image: linear-gradient(160deg, rgb(255 107 0 / 0.3) 0%, rgb(255 107 0 / 0.08) 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      0 16px 26px -14px rgb(0 0 0 / 0.9);
  }

  .support-item:hover .support-badge::after {
    opacity: 1;
    transform: scale(1);
  }

  /* Cantos técnicos em laranja */
  .support-panel::before,
  .support-panel::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--color-accent-orange);
    border-style: solid;
    border-width: 0;
    opacity: 0.9;
    pointer-events: none;
  }

  .support-panel::before {
    top: 14px;
    left: 14px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .support-panel::after {
    right: 14px;
    bottom: 14px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .support-badge,
    .support-badge::after {
      transition: none;
    }

    .support-item:hover .support-badge {
      transform: none;
    }
  }
</style>
