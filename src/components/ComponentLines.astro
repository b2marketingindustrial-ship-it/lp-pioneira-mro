---
import Icon from './Icon.astro'
import Eyebrow from './Eyebrow.astro'

interface Line {
  index: string
  tag: string
  icon: string
  title: string
  description: string
  types: readonly string[]
  brands?: readonly string[]
  cta: string
}

const lines: readonly Line[] = [
  {
    index: '01',
    tag: 'Mancais',
    icon: 'box',
    title: 'Mancais Industriais',
    description:
      'Componentes para suporte, fixação e aplicação de rolamentos em máquinas e equipamentos industriais.',
    types: [
      'Mancais pedestal',
      'Mancais flangeados',
      'Mancais bipartidos',
      'Caixas para rolamentos',
    ],
    brands: ['Rolmax'],
    cta: 'Cotar mancais',
  },
  {
    index: '02',
    tag: 'Acoplamentos',
    icon: 'gear',
    title: 'Acoplamentos Industriais',
    description:
      'Componentes destinados à transmissão de movimento entre motores, bombas, redutores e outros equipamentos.',
    types: [
      'Acoplamentos de engrenagem',
      'Acoplamentos de grade',
      'Acoplamentos elásticos',
      'Acoplamentos de lâminas',
      'Acoplamentos de pinos',
    ],
    brands: ['Vulkan', 'Tecnon'],
    cta: 'Cotar acoplamentos',
  },
  {
    index: '03',
    tag: 'Vedação',
    icon: 'droplet',
    title: 'Retentores e Vedações Industriais',
    description:
      'Componentes destinados a diferentes necessidades de vedação em máquinas e equipamentos.',
    types: ['Retentores', 'Gaxetas', 'Anéis raspadores', 'V-Rings'],
    cta: 'Cotar retentores',
  },
  {
    index: '04',
    tag: 'Acessórios',
    icon: 'wrench',
    title: 'Buchas e Acessórios para Rolamentos',
    description: 'Componentes utilizados em operações de fixação, montagem e desmontagem.',
    types: [
      'Buchas de fixação',
      'Buchas de desmontagem',
      'Porcas',
      'Arruelas',
      'Acessórios de montagem',
    ],
    cta: 'Consultar acessórios',
  },
]
---

<section id="linhas" class="bg-neutral-light pt-20 pb-10">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="max-w-2xl">
      <Eyebrow>Linha de componentes MRO</Eyebrow>
      <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
        Soluções para manutenção e reposição industrial
      </h2>
      <p class="mt-3 font-sans text-[15px] leading-relaxed text-ink-soft">
        Mancais, acoplamentos, retentores, vedações, buchas e acessórios para diferentes
        necessidades da manutenção.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {lines.map((line) => (
        <article class="component-card group relative flex flex-col overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]">
          {/* Linha de acento no topo — cresce no hover */}
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          />

          {/* Palco do ícone */}
          <div class="component-card__stage relative flex h-36 items-center justify-center overflow-hidden">
            <span class="component-card__badge relative z-[1] flex size-20 items-center justify-center rounded-full text-primary-dark">
              <Icon name={line.icon} class="size-9" />
            </span>

            <span class="absolute top-4 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-primary-dark/40">
              {line.index}
            </span>

            <span class="absolute top-3.5 right-4 z-[2] rounded-full border border-primary-dark/10 bg-neutral-light px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-primary-dark/75 uppercase">
              {line.tag}
            </span>
          </div>

          {/* Conteúdo */}
          <div class="flex flex-1 flex-col px-6 pt-4 pb-4">
            <h3 class="font-display text-lg leading-snug font-extrabold text-ink sm:min-h-[2.6em]">
              {line.title}
            </h3>

            <p class="mt-2 font-sans text-[13px] leading-relaxed text-ink-soft">
              {line.description}
            </p>

            <ul class="mt-4 flex flex-col gap-2">
              {line.types.map((type) => (
                <li class="flex items-center gap-2.5 font-sans text-[13px] font-medium text-ink">
                  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-accent-orange/10 text-accent-orange">
                    <Icon name="check" class="size-3" />
                  </span>
                  {type}
                </li>
              ))}
            </ul>

            {line.brands && (
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="font-sans text-[10px] font-semibold tracking-[0.16em] text-ink-soft uppercase">
                  Marcas
                </span>
                {line.brands.map((brand) => (
                  <span class="rounded border border-primary-dark/15 bg-neutral-gray-100 px-2 py-0.5 font-sans text-[11px] font-bold tracking-[0.08em] text-primary-dark uppercase">
                    {brand}
                  </span>
                ))}
              </div>
            )}

            <a
              href="#cotacao"
              class="mt-auto flex items-center justify-between gap-3 border-t border-neutral-gray-200/60 pt-4 font-sans text-[13px] font-bold text-primary-dark transition-colors duration-200 hover:text-accent-orange"
            >
              <span>{line.cta}</span>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-gray-100 text-primary-dark transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light">
                <Icon name="arrow-right" class="size-3.5" />
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Palco claro: gradiente suave + malha de pontos que esmaece nas bordas */
  .component-card__stage {
    background-image: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  }

  .component-card__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(0, 33, 71, 0.16) 1px, transparent 1.2px);
    background-size: 18px 18px;
    /* Pontos nas bordas, centro limpo atrás do ícone */
    mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    -webkit-mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    opacity: 0.7;
    pointer-events: none;
  }

  /* Disco técnico atrás do ícone */
  .component-card__badge {
    background-image: linear-gradient(160deg, #ffffff 0%, #eef3f9 100%);
    border: 1px solid rgb(0 33 71 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 1),
      0 14px 26px -16px rgb(0 33 71 / 0.55);
    transition:
      transform 500ms ease,
      border-color 300ms ease,
      color 300ms ease;
  }

  .component-card:hover .component-card__badge {
    transform: scale(1.06);
    border-color: rgb(255 107 0 / 0.5);
    color: var(--color-accent-orange);
  }

  /* Canto técnico discreto que aparece no hover */
  .component-card::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 14px;
    height: 14px;
    border-right: 2px solid var(--color-accent-orange);
    border-bottom: 2px solid var(--color-accent-orange);
    opacity: 0;
    transform: translate(4px, 4px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
    pointer-events: none;
  }

  .component-card:hover::after {
    opacity: 0.9;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .component-card,
    .component-card * {
      transition: none !important;
    }

    .component-card:hover {
      transform: none;
    }
  }
</style>
