---
import { Image } from 'astro:assets'
import sectionBackground from '../assets/why-brand-background.png'
import technician from '../assets/tecnico-marcas.webp'
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { site } from '../data/site'

/* Os cards seguem a cadeia identificar → encontrar → orientar como benefício
   para a manutenção; os dois últimos dizem com quem e onde a Pioneira atende. */
const reasons = [
  {
    icon: 'search',
    title: 'Identificação do componente',
    description:
      'Referência, foto ou medida bastam para começar. A equipe faz o resto da identificação.',
  },
  {
    icon: 'compass',
    title: 'Busca do componente certo',
    description: 'Equivalentes e marcas representadas para localizar o item, mesmo fora de linha.',
  },
  {
    icon: 'sliders',
    title: 'Orientação na aplicação',
    description:
      'Especificação alinhada ao regime de trabalho da máquina, não só ao código da peça.',
  },
  {
    icon: 'users',
    title: 'Atendimento B2B',
    description: 'Relacionamento comercial direcionado a Manutenção, PCM, Engenharia e Compras.',
  },
  {
    icon: 'map-pin',
    title: 'Campinas e região',
    description: 'Presença regional e atuação comercial voltada ao mercado industrial.',
  },
] as const
---

<section id="diferenciais" class="relative bg-neutral-gray-100 pt-6 pb-8" data-why>
  {/* Bloco azul em largura total */}
  <div class="why-hero navy-premium relative overflow-hidden">
    <Image
      src={sectionBackground}
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      class="why-background"
    />
    <span aria-hidden="true" class="why-overlay pointer-events-none absolute inset-0"></span>

    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-24 -right-20 size-72 rounded-full bg-accent-orange/15 blur-3xl"
    ></span>

    <div class="relative mx-auto w-full max-w-page px-6 pt-10 pb-8 lg:px-10 lg:pt-10 lg:pb-24">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-5 left-6 hidden size-[18px] border-t-2 border-l-2 border-accent-orange opacity-90 lg:top-8 lg:left-10 lg:block"
      ></span>
      <div class="max-w-xl lg:max-w-[46%]">
        <Eyebrow tone="light">Por que a {site.brandShort}</Eyebrow>
        <h2 class="mt-3 font-display text-3xl leading-[1.1] font-extrabold text-neutral-light sm:text-4xl xl:text-[44px]">
          Quem atende
          <br />
          conhece o componente.
        </h2>

        <span aria-hidden="true" class="mt-5 block h-[3px] w-16 bg-accent-orange"></span>

        <p class="mt-5 font-sans text-[15px] leading-relaxed text-neutral-light/75 sm:text-base">
          Do outro lado do atendimento está uma equipe que conhece o componente, a aplicação e o que
          a sua máquina pede, inclusive quando ela está parada.
        </p>

        <Button
          variant="primary"
          class="mt-7 w-full shadow-[0_14px_30px_-12px_rgba(255,107,0,0.85)] sm:w-auto"
        >
          Solicite sua cotação
        </Button>
      </div>
    </div>

    <div class="why-people">
      <Image
        src={technician}
        alt="Técnico da Pioneira de braços cruzados, cercado pelos logotipos Vedabrás, Tecnon, Rexon, BGL, BRG Mancais, Vulkan e ITW"
        format="webp"
        width={1220}
        loading="lazy"
        decoding="async"
        class="why-technician"
      />
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco azul */}
  <div class="relative z-10 mx-auto -mt-16 max-w-page px-6 lg:px-10">
    <ul
      class="why-track -mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label={`Diferenciais da ${site.brandShort}`}
    >
      {reasons.map((reason) => (
        <li class="why-card group relative flex w-[78%] shrink-0 snap-start flex-col gap-2.5 overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-4 shadow-[0_24px_48px_-24px_rgba(0,24,48,0.45)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_32px_60px_-28px_rgba(0,33,71,0.5)] sm:w-[44%] lg:w-auto">
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          />

          <div class="flex items-start gap-2.5">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-neutral-gray-100 text-primary-dark-800 transition-colors duration-300 group-hover:bg-accent-orange/10 group-hover:text-accent-orange">
              <Icon name={reason.icon} class="size-[18px]" />
            </span>

            <h3 class="min-h-[2.5em] font-display text-[14px] leading-[1.25] font-extrabold text-ink">
              {reason.title}
            </h3>
          </div>

          <p class="min-h-[4.9em] font-sans text-[13px] leading-relaxed text-ink-soft">
            {reason.description}
          </p>
        </li>
      ))}
    </ul>

    {/* Setas do trilho — apenas no mobile, onde a lista rola */}
    <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 cursor-pointer items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 cursor-pointer items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</section>

<style>
  .why-hero {
    isolation: isolate;
    min-height: 430px;
  }

  .why-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 63% center;
  }

  .why-overlay {
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgb(0 34 68 / 96%) 0%,
        rgb(0 34 68 / 88%) 33%,
        rgb(0 34 68 / 42%) 58%,
        rgb(0 34 68 / 12%) 100%
      ),
      linear-gradient(0deg, rgb(0 21 44 / 38%), transparent 45%);
  }

  .why-people {
    position: relative;
    z-index: 1;
    width: min(100%, 620px);
    height: 460px;
    margin: 0 auto;
    pointer-events: none;
  }

  .why-technician {
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: 50%;
    height: 100%;
    width: auto;
    max-width: 100%;
    transform: translateX(-50%);
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 12px 20px rgb(0 15 35 / 25%));
  }

  @media (min-width: 1024px) {
    .why-hero {
      display: flex;
      align-items: center;
      min-height: 520px;
    }

    .why-background {
      object-position: center;
    }

    .why-people {
      position: absolute;
      right: 2%;
      bottom: 0;
      width: 49%;
      /* Abaixo de 100% para a figura não encostar no topo da seção. */
      height: 88%;
      max-height: 500px;
    }
  }

  /* Trilho horizontal sem barra de rolagem aparente */
  .why-track {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .why-track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card * {
      transition: none !important;
    }

    .why-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
